/*
 * `_Nullable` is a Clang qualifier, and `subscript bind` reads the
 * annotation from Clang. Every other compiler rejects the token, MSVC
 * `cl` included, so the header removes it there.
 */
#if defined(__clang__)
#pragma clang diagnostic ignored "-Wnullability-completeness"
#else
#define _Nullable
#endif

